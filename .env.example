# Salin file ini menjadi .env.local lalu isi nilainya.
# Supabase: buat project gratis di https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Wajib untuk dashboard admin) Service role key agar admin bisa menulis data
# (bypass RLS). Ambil di Supabase -> Settings -> API -> service_role (secret).
# JANGAN pernah expose ke client / commit ke repo.
SUPABASE_SERVICE_ROLE_KEY=

# (Opsional) Override kredensial admin & secret sesi.
# Default: admin@portofolio.com / admin123
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
